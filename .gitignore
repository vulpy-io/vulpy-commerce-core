node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
deploy/.env
environments/*/.env

# Testing
coverage
__pycache__/
*.pyc
*.pyo
playwright-report/
test-results/

