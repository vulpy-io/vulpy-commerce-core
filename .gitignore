/wafer_*.html

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
out/
build
dist
.medusa/
apps/storefront/media/
apps/medusa-backend/static/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
.tmp/
.data/
.vulpy/ingress-target.json
.agent/generated-context.md
# Live agent status (TCP probes + log tails) — regenerated on every container start
.agent/status.md
# Operator workfiles — plans, briefs, handoffs, reviews, release scratch,
# legal drafts, and generated coordination state. Never product source.
.work/
# Compatibility paths from older agent workflows; all workfiles belong in .work/
.hermes/tasks/
.hermes/plans/
.hermes/briefs/
.hermes/reviews/
.hermes/factory/
.hermes/design/
.hermes/legal/
.hermes/store-state.json
# Agent command mailbox — runtime files only, not the directory structure
agent-cmds/req/*
!agent-cmds/req/.gitkeep
agent-cmds/resp/*
!agent-cmds/resp/.gitkeep

# SearXNG settings are a committed, secret-free Core runtime input. The
# per-install secret is supplied through SEARXNG_SECRET in the environment.

# Hermes runtime skill usage files
.hermes/skills/.usage.json
.hermes/skills/.usage.json.lock

# Fox runtime marker
.qdrant-initialized
# Agent runtime state — generated per workspace/session, not source
.agent/
# Hermes runtime files — generated, not source
.copilot/
.cache/
.local/share/code-server/
.config/code-server/
.cache/Microsoft/DeveloperTools/
.hermes/skills/.bundled_manifest
.hermes/skills/.curator_state
.hermes/skills/.curator_backups/
# Impeccable runtime state (the app's live config under apps/storefront/.impeccable is separate)
/.impeccable/live/
# Design mockups and screenshot evidence — disposable working artifacts
.design-specs/

# Vulpy.io website draft — working clone of fox-in-the-box-ai/landing (gitignored)
.hermes/fox-landing/

# Graphify knowledge graph — all outputs are derived/auto-regenerated by the post-commit hook
graphify-out/
# Knowledge pack exports (created by graphify export)
*-knowledge-pack-*/

# pnpm global content-addressable store (when store-dir is inside the workspace)
.pnpm-store/
.backups/
.worktrees/
