{
  "name": "@apps/medusa-backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:minimal": "medusa exec ./src/scripts/seed.ts",
    "seed:demo": "medusa exec ./src/scripts/seed-demo-catalog.ts",
    "strip:demo": "medusa exec ./src/scripts/strip-demo-catalog.ts",
    "start": "medusa start",
    "dev": "medusa develop -p ${MEDUSA_PORT:-9000}",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "sync-products-to-payload": "medusa exec ./src/scripts/sync-products-to-payload.ts",
    "sync-categories-to-payload": "medusa exec ./src/scripts/sync-categories-to-payload.ts",
    "update-bestseller-rankings": "medusa exec ./src/scripts/update-bestseller-rankings.ts",
    "test": "pnpm test:unit",
    "test:watch": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand --forceExit --passWithNoTests",
    "add-user": "medusa exec ./src/scripts/ensure-admin.ts",
    "ensure-admin": "medusa exec ./src/scripts/ensure-admin.ts",
    "print-publishable-key": "medusa exec ./src/scripts/print-publishable-key.ts write-env",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.13.0",
    "@medusajs/admin-shared": "2.13.0",
    "@medusajs/cli": "2.13.0",
    "@medusajs/dashboard": "2.13.0",
    "@medusajs/draft-order": "2.13.0",
    "@medusajs/file": "2.13.0",
    "@medusajs/framework": "2.13.0",
    "@medusajs/icons": "2.13.0",
    "@medusajs/js-sdk": "2.13.0",
    "@medusajs/medusa": "2.13.0",
    "@medusajs/types": "2.13.0",
    "@medusajs/ui": "^4.0.30",
    "@orama/orama": "^3.1.5",
    "@tanstack/react-query": "5.64.2",
    "basic-ftp": "^6.0.1",
    "fast-xml-parser": "^5.9.2",
    "ioredis": "^5.4.1",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/pg": "^8.11.14",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": ">=20"
  }
}
