# ===========================================
# Database
# ===========================================
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa

# ===========================================
# Redis (optional)
# ===========================================
REDIS_URL=redis://127.0.0.1:6379

# ===========================================
# Security
# ===========================================
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ===========================================
# CORS
# ===========================================
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# ===========================================
# URLs
# ===========================================
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:3000
# Extra Vite allowed hosts for Medusa admin when tunneling (comma-separated, host only)
# Example: .ngrok-free.dev or ridden-rejoicing-fence.ngrok-free.dev
__MEDUSA_ADMIN_ADDITIONAL_ALLOWED_HOSTS=

# Medusa Admin Vite HMR is disabled by default for remote dev previews.
# Reason: Medusa's admin bundler advertises a random internal websocket port
# (wss://<host>:40xxx/app), which is unreachable through Fox Tailscale/public edge.
# Set MEDUSA_ADMIN_HMR=1 only for direct local development when you want Admin hot reload.
MEDUSA_ADMIN_HMR=0

# ===========================================
# Stripe
# ===========================================
# Stripe — secret key (runtime only, never expose to browser or logs)
# Use sk_test_… for dev/staging, sk_live_… for production
STRIPE_API_KEY=
# Stripe webhook secret for verifying events
STRIPE_WEBHOOK_SECRET=

# ===========================================
# Medusa Publishable Key (for internal API calls)
# ===========================================
MEDUSA_PUBLISHABLE_KEY=
# Leave empty (default) → the admin SPA calls the API same-origin (works via
# Tailscale, public edge, and loopback). Set only when the admin SPA is hosted
# separately from the API (e.g. a CDN), then use the API's public origin.
VITE_MEDUSA_BACKEND_URL=

# ===========================================
# Payload product-content sync
# ===========================================
PAYLOAD_URL=http://localhost:3000
# Payload user API key (recommended) or JWT from POST /api/users/login.
# Generate in Payload admin: Users → your user → Enable API Key.
PAYLOAD_SYNC_API_KEY=

S3_FILE_URL=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=

# ===========================================
# Email (SMTP) — optional; configure in Medusa admin (Settings → Email) for local dev.
# Env vars below override admin DB settings (typical for production / deploy/.env).
# ===========================================
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=My Shop
