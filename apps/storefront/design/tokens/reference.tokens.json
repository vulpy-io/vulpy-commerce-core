    "font": {
      "family": {
        "body": {
          "$type": "fontFamily",
          "$value": [
            "var(--font-manrope)",
            "Manrope Variable",
            "Manrope",
            "Segoe UI",
            "sans-serif"
          ]
        },
        "heading": {
          "$type": "fontFamily",
          "$value": [
            "var(--font-sora)",
            "Sora Variable",
            "Sora",
            "Segoe UI",
            "sans-serif"
          ]
        }
      },
      "weight": {
        "light": {
          "$type": "fontWeight",
          "$value": 320,
          "$description": "Display/h1 — ultra-light; large type relies on size, not weight, for hierarchy"
        },
        "regular": {
          "$type": "fontWeight",
          "$value": 450,
          "$description": "Body text — slightly bolder than standard 400 for warmth and legibility"
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500,
          "$description": "h3, h5, feature text"
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600,
          "$description": "h4/card titles, overlines, UI emphasis"
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        },
        "button": {
          "$type": "fontWeight",
          "$value": 800,
          "$description": "CTA buttons — very bold, intentional contrast against body weight"
        }
      },
      "size": {
        "xs": {
          "$type": "dimension",
          "$value": { "value": 12, "unit": "px" },
          "$description": "Fine print, legal"
        },
