MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_ASSET_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
# Stripe — publishable key (build-time, safe to expose)
# Get from https://dashboard.stripe.com/apikeys
# Use pk_test_… for dev/staging, pk_live_… for production
NEXT_PUBLIC_STRIPE_KEY=

# Optional Matomo — leave empty (tracker no-op) or run: pnpm db:matomo:up
# NEXT_PUBLIC_MATOMO_URL=http://localhost:8081
# NEXT_PUBLIC_MATOMO_SITE_ID=1

# Optional Google Tag Manager (GA4 ecommerce via dataLayer) — leave empty = no-op
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional Google Search Console site verification meta
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Storefront html lang (monolingual). Padelbaza/UA shops can set uk.
# NEXT_PUBLIC_DEFAULT_LOCALE=en
# Multi-locale hreflang is off by default; enable only with real locale URLs:
# NEXT_PUBLIC_SITE_LOCALES=
# NEXT_PUBLIC_HREFLANG_ENABLED=false

# Staging / preview crawl lock (runtime — restart storefront after changing; no rebuild).
# true|1|yes → meta robots noindex,nofollow + X-Robots-Tag + robots.txt Disallow: / + empty sitemap.
# Leave unset/false on production. Optional Caddy backup: X_ROBOTS_TAG in deploy/.env (edge only).
# SITE_NOINDEX=true

# Storefront catalog
SHOP_PAGE_SIZE=20
# Set to true to show header account link and checkout login/registration
NEXT_PUBLIC_ENABLE_CUSTOMER_ACCOUNTS=true

# Promotion / coupon code field on checkout (default: enabled). Set to false to hide.
NEXT_PUBLIC_ENABLE_PROMOTION_CODES=true

# B2B price gating: set REQUIRE_LOGIN_FOR_PRICES=true in repo root `.env` (dev)
# or `deploy/.env` (prod) — not here. See AGENTS.md §7.
# Commercial persona mode (same locations): PRICE_GATE_MODE=off|login|quote.
#   off    = prices public (default)
#   login  = guests see "Login to see price"
#   quote  = guests get quotation bag + "Request a Quote"

# Payload CMS (content — separate from Medusa DB)
PAYLOAD_SECRET=dev-payload-secret-change-me
PAYLOAD_DATABASE_URL=postgres://medusa:medusa@localhost:5432/payload
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=change-me
PAYLOAD_SEED_EMAIL=admin@example.com
PAYLOAD_SEED_PASSWORD=supersecret

# Medusa backend sync target values
PAYLOAD_URL=http://localhost:3000
PAYLOAD_SYNC_API_KEY=
