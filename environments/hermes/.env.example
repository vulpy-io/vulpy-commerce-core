# Host-level Hermes / Fox agent settings (not an instance stack).
# Copy to environments/hermes/.env — or let: pnpm vulpy install / hermes up create it.
#
# One Hermes serves all environments (dev/staging/live) on the app-scoped network.
# See .hermes/ARCHITECTURE.md
#
# All values are overridable via this file, install CLI flags, or environment
# variables — never edit scripts to change a port or bind.

VULPY_ENV=hermes
COMPOSE_PROJECT_NAME=vulpy-commerce-hermes
DATA_DIR=.data/hermes
VULPY_APP_ID=vulpy-commerce
VULPY_APP_NETWORK=vulpy-app-vulpy-commerce

HERMES_ACCESS=tailscale
HERMES_BIND=127.0.0.1
HERMES_PORT=8787
# VULPY_HERMES_IMAGE — runtime image to pull/use. Released Core/Pro installs
# should set this to the exact GHCR image/tag (for example
# ghcr.io/vulpy-io/vulpy-hermes-core:0.1.0-alpha.34). Local development leaves
# it unset and uses vulpy-hermes:local; `hermes up` can then build locally.
VULPY_HERMES_IMAGE=
# VULPY_HERMES_AUTO_REBUILD — when 1 (default), `pnpm vulpy hermes up` compares
# a content fingerprint of the image inputs (Dockerfile.hermes + COPY sources +
# security checksums) against the fingerprint LABEL on the resolved
# VULPY_HERMES_IMAGE (or vulpy-hermes:local when unset) and
# runs scripts/vulpy-hermes-rebuild.sh --force FIRST when stale. This makes
# down/up self-healing: source changes are always baked before the container
# starts. Set 0 to disable (plain up, current behavior). The rebuild has its
# own backup-tag + rollback safety; logs tee to .data/hermes/logs/.
VULPY_HERMES_AUTO_REBUILD=1
HERMES_IMAGE=ghcr.io/fox-in-the-box-ai/cloud:stable
# Publish in-container Next (:3000) and Medusa (:9000) to host loopback when
# needed for host tooling. Fox Tailscale serve uses the shared container netns.
HERMES_DEV_PORTS=0
HERMES_DEV_BIND=127.0.0.1
HERMES_DEV_STOREFRONT_PORT=3000
HERMES_DEV_MEDUSA_PORT=9000
HERMES_DOMAIN=
HERMES_CADDY_SNIPPET=./deploy/caddy-snippets/empty.caddy
# Public Fox (access=domain|random|both): install writes these from admin email/password.
# Dev edge Caddy and live hermes-public.caddy both use them.
# HERMES_BASIC_AUTH_USER=
# HERMES_BASIC_AUTH_HASH=

# Extension sidecar proxy max response bytes in the WebUI (default 8388608).
# The message-renderer session polls can exceed the old 512 KiB cap on heavy
# transcripts → 502 {"error": "Extension sidecar response too large"}.
# Passed through docker-compose.hermes.yml into the container env.
# HERMES_WEBUI_SIDECAR_MAX_RESPONSE_BYTES=8388608

# SearXNG — Fox's keyless default web search (host-level sidecar, internal-only).
# Hermes auto-detects the SearXNG provider when SEARXNG_URL is present (set in
# docker-compose.hermes.yml), so Fox searches via http://searxng:8080.
# Not published to the host (multi-tenant hosts must not collide on 8888);
# debug the UI with a temporary `docker compose ... run --rm -p 8080:8080 searxng`.
# SEARXNG_PORT is accepted for back-compat but no longer used by the compose file.
# SearXNG secret — required by the official image. Generated by
# hermes-compose.sh if unset; keep it secret.
# SEARXNG_SECRET=
# To override the search backend, set TAVILY_API_KEY / EXA_API_KEY /
# FIRECRAWL_API_KEY here — auto-detection prefers them over searxng.
# NOTE: brave-free ranks BELOW searxng in Hermes' auto-pick chain — to force
# Brave, pin the backend via `hermes tools`.

# Fox Tailscale sidecar (primary private access). 1 = include compose overlay.
HERMES_TAILSCALE=0
TS_HOSTNAME=vulpy-commerce
TS_AUTHKEY=
TS_IMAGE=tailscale/tailscale:stable
TS_USERSPACE=false
TS_EXTRA_ARGS="--accept-routes=false --accept-dns=false"

# Block AWS instance metadata (IMDS) on EC2/Lightsail so Fox cannot pick up the
# instance IAM role. Applied only when the host is detected as AWS. 1 = on
# (default on AWS), 0 = off. Non-AWS hosts ignore this.
# ASG fleets should still disable IMDS in the launch template (Terraform).
VULPY_IMDS_LOCK=1

HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------------------
# Vulpy Commerce WebUI extension — runtime config (extensions/hermes-webui/).
# Rendered by scripts/hermes-fox-entrypoint.sh (Item 8b) at container start
# into /extensions/vulpy-commerce.config.json — the side-panel iframe tabs.
#
# VULPY_WEBUI_IFRAMES — JSON array of {id,label,url} iframe targets for the
# side panel. Empty (default) = the panel derives Storefront / Medusa Admin /
# Payload Admin tabs from the page's URL (shop/api ports come from
# VULPY_WEBUI_SHOP_PORT / VULPY_WEBUI_API_PORT, fallback 3000/9000). Non-empty
# entries always win over the derived tabs. Dev example (uncomment to use):
# VULPY_WEBUI_IFRAMES=[{"id":"storefront","label":"Storefront","url":"http://localhost:3000"},{"id":"admin","label":"Medusa Admin","url":"http://localhost:9000/app"},{"id":"editor","label":"Code Editor","url":"https://vulpy-commerce-private.tail873f17.ts.net:8080"}]
#
# vulpy_codeeditor_enabled — embedded Code Editor is enabled by default.
# Set false/0/no/off to keep code-server idle, hide the Editor tab, and remove
# its Tailscale route while preserving the rest of the WebUI.
# vulpy_codeeditor_enabled=true
# VULPY_CODESERVER_PORT=8080
# VULPY_CODESERVER_PASSWORD=change-me
#
# VULPY_WEBUI_SHOP_PORT / VULPY_WEBUI_API_PORT — dev shop/api ports used by the
# derived side-panel tabs. Passthrough of VULPY_SHOP_PORT / VULPY_API_PORT
# (else HERMES_DEV_STOREFRONT_PORT / HERMES_DEV_MEDUSA_PORT, else 3000/9000).
# Set them here if your dev ports differ from 3000/9000 — a value placed only
# in environments/dev/.env is NOT visible to the hermes compose file.
# HERMES_WEBUI_CSP_FRAME_EXTRA — space-separated origins the WebUI server
# adds to its CSP frame-src (besides 'self'). The side panel derives the
# Storefront / Medusa Admin / Payload Admin tabs from window.location, so the
# allowlist must cover all access modes: Tailscale (*.ts.net any port),
# public edge (shop + api hosts), loopback (127.0.0.1 / localhost). Wildcard
# subdomain + port allowed, exact shape https://*.example.com:*. Every entry
# must be a real host pattern — the server ignores the WHOLE list if any entry
# is invalid, so replace the example hosts with your actual shop/api hosts.
# HERMES_WEBUI_CSP_FRAME_EXTRA="https://*.ts.net:* https://shop.example.com:* https://api.example.com:* http://127.0.0.1:* http://localhost:*"
# HERMES_WEBUI_CSP_FRAME_ANCESTORS_EXTRA — space-separated origins allowed to
# EMBED the WebUI in an iframe (CSP frame-ancestors). Default 'none' when
# unset/empty/invalid. Opt in only when you deliberately expose the WebUI in a
# frame — e.g. a live-demo shell that iframes the Fox admin panel. Same host
# shape as FRAME_EXTRA (https://host, optional wildcard subdomain + port).
# HERMES_WEBUI_CSP_FRAME_ANCESTORS_EXTRA="https://vulpy.io https://vulpy-commerce-private.tail873f17.ts.net:4327"
# HERMES_WEBUI_CSP_CONNECT_EXTRA — space-separated origins allowed by
# connect-src for browser-side probes/fetches (including the Code Editor
# availability probe). Keep this aligned with frame-extra for external apps.
# HERMES_WEBUI_CSP_CONNECT_EXTRA="https://*.ts.net:* https://shop.example.com:* https://api.example.com:* http://127.0.0.1:* http://localhost:*"
# ---------------------------------------------------------------------------
