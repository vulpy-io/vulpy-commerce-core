# Project identity (Docker Compose project name; defaults to folder name when empty)
COMPOSE_PROJECT_NAME=

# Persistent Docker data (relative to repo root, or absolute path)
DATA_DIR=.data

# Override on NTFS/exFAT hosts (Postgres/Redis/Matomo need POSIX; auto-fallback if unset)
# POSTGRES_DATA_DIR=${HOME}/.local/share/my-shop/postgres
# MATOMO_DATA_DIR=${HOME}/.local/share/my-shop/matomo
# MATOMO_DB_DATA_DIR=${HOME}/.local/share/my-shop/matomo-db

# Docker Compose host identity mapping for Hermes workspace write access.
# Set these values per machine (Linux: `id -u` and `id -g`).
HOST_UID=1000
HOST_GID=1000

# --- Database + cache (required for dev — matches docker-compose.yml defaults) ---
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
PAYLOAD_DATABASE_URL=postgres://medusa:medusa@localhost:5432/payload
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret-dev-only
COOKIE_SECRET=supersecret-dev-only

# --- Shop behaviour (read by medusa-backend + storefront; same name in deploy/.env for prod) ---
# B2B / trade catalog: hide prices and add-to-cart until customer signs in.
# Requires NEXT_PUBLIC_ENABLE_CUSTOMER_ACCOUNTS=true in apps/storefront/.env.
# REQUIRE_LOGIN_FOR_PRICES=false
#
# Commercial persona mode (overrides REQUIRE_LOGIN_FOR_PRICES when set):
#   PRICE_GATE_MODE=off    (default) prices public, no gating
#   PRICE_GATE_MODE=login  hide prices from guests; "Login to see price"
#   PRICE_GATE_MODE=quote  hide prices; quotation bag + "Request a Quote"
# PRICE_GATE_MODE unset + REQUIRE_LOGIN_FOR_PRICES=true  -> treated as login
# PRICE_GATE_MODE=off

# Staging crawl lock lives in apps/storefront/.env (local) or deploy/.env (prod runtime):
# SITE_NOINDEX=true  # restart storefront; see apps/storefront/.env.example

# --- Tenant resource split (percentages OF the host-owned tenant share) ---
# The host operator defines this tenant's share of host RAM/CPU in the
# root-owned manifest /etc/vulpy/tenants/<appId>.conf (written at install by
# `sudo bash scripts/vulpy-tenant-limits.sh install --tenant-mem-share N --tenant-cpu-share N`;
# defaults 25 each). These vars divide THAT share between services — they are
# NOT absolute values, and they cannot raise the ceiling: the root-generated
# artifacts (/etc/vulpy/tenant-limits-<appId>.env, /etc/vulpy/compose-limits-<appId>.yml)
# clamp at the share. Edit here, then refresh (as root):
#   sudo bash scripts/vulpy-tenant-limits.sh refresh
# Status: `pnpm vulpy tenant-limits status` (readable without root).
# VULPY_MEM_SPLIT_STOREFRONT_PERCENT=40
# VULPY_MEM_SPLIT_MEDUSA_PERCENT=35
# VULPY_MEM_SPLIT_POSTGRES_PERCENT=15
# VULPY_MEM_SPLIT_REDIS_PERCENT=5
# VULPY_MEM_SPLIT_FOX_PERCENT=20
# VULPY_CPU_SPLIT_STOREFRONT_PERCENT=40
# VULPY_CPU_SPLIT_MEDUSA_PERCENT=35
# VULPY_CPU_SPLIT_POSTGRES_PERCENT=15
# VULPY_CPU_SPLIT_REDIS_PERCENT=5
# VULPY_CPU_SPLIT_FOX_PERCENT=20
